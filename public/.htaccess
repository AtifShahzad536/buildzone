<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route all API requests to the PHP REST API handler
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirect all other requests to index.html (SPA Routing)
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set X-XSS-Protection "1; mode=block"

  # Disable cache for index.html so users get latest updates
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </Files>

  # Cache static assets for fast loading
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot|glb|gltf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>
